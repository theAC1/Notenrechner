# === REQUIRED ===
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# === REGISTRATION GATE ===
# EITHER set INVITE_CODE (recommended) ...
INVITE_CODE=
# ... OR set ALLOW_OPEN_REGISTRATION=true for a fully open signup page.
ALLOW_OPEN_REGISTRATION=false

# === DATABASE ===
# Local dev: use a file (default).
DB_PATH=data/notenrechner.db
# Production (Turso/libSQL): set DB_URL + DB_AUTH_TOKEN instead.
# DB_URL=libsql://your-db.turso.io
# DB_AUTH_TOKEN=

# === NETWORK ===
PORT=3000
HOST=0.0.0.0
# Comma-separated allowed origins. Use https://yourdomain.tld in prod.
CORS_ORIGIN=http://localhost:5173
# Set true when behind a reverse proxy (Vercel, Nginx, Cloudflare).
TRUST_PROXY=false

# === RATE LIMITING ===
# Comma-separated IPs exempt from the global rate limit (rare, typically empty).
RATELIMIT_ALLOWLIST=

LOG_LEVEL=info
